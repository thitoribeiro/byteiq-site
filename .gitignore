# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# Cloudflare / OpenNext generated files
.open-next/
.wrangler/

# AI coding-assistant tooling scaffolding (skills/agents installed by the
# editor, not ByteIQ application content).
.agent/
.cursor/
.gemini/

# .claude/ — ignore everything by default (local settings, agents, and the
# generic/third-party skills that ship with or can be installed separately
# into the editor), then selectively re-allow only what's genuinely
# ByteIQ-specific: the byteiq-brand skill and its supporting files. None of
# the current agents under .claude/agents/ are ByteIQ-specific (checked),
# so that directory stays fully ignored; revisit if that changes.
.claude/*
!.claude/skills
.claude/skills/*
!.claude/skills/byteiq-brand
# Defense-in-depth: never track generated binaries/caches even inside an
# allowed skill directory.
.claude/**/scripts/bin/
.claude/**/__pycache__/
.claude/**/*.pyc
